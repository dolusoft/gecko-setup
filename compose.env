# Environment variables for docker-compose
# Docker Hub credentials for managerapi and updater (image pulls from dolusoftcomp).
# Set per install; a value stored in CoreApi config wins. Will come from the license server later.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
# Secrets
SHARED_PASSWORD=test
# Databases and MinIO's root password (MinIO also saved into CoreApi's internal S3
# adapter on first install). MinIO refuses to start with fewer than 8 characters.
SERVICE_PASSWORD=test
# FreeRADIUS sends this as X-Radius-Secret to HotspotApi. Put the same value in
# HotspotApi's Radius:RestSharedSecret (CoreApi config) only AFTER FreeRADIUS runs
# with it; the reverse order makes every RADIUS login fail with 401. Empty = no check.
RADIUS_REST_SECRET=
# Host address the admin UIs (MinIO console/API 9002/9003, phpLDAPadmin 8080,
# kafka-ui 9080) are published on. Default 127.0.0.1: reach them over an SSH tunnel.
# Set 0.0.0.0 only on an isolated dev/lab host.
ADMIN_BIND_ADDRESS=127.0.0.1
# Kafka external listener
# Address advertised on Kafka's EXTERNAL listener. Clients connecting from outside
# the compose network are told to reach the broker here, so this must be THIS host's
# own address -- set it per install. Compose fails loudly if it is unset or empty.
KAFKA_EXTERNAL_HOST=
