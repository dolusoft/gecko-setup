# Environment variables for docker-compose
# Docker Hub credentials for managerapi and updater (image pulls from dolusoftcomp).
# Set per install; a value stored in CoreApi config wins. Will come from the license server later.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
# Secrets
SHARED_PASSWORD=test
SERVICE_PASSWORD=test
# Kafka external listener
# Address advertised on Kafka's EXTERNAL listener. Clients connecting from outside
# the compose network are told to reach the broker here, so this must be THIS host's
# own address -- set it per install. Compose fails loudly if it is unset or empty.
KAFKA_EXTERNAL_HOST=172.16.40.20
